    {
      "name": "4. Project Members",
      "item": [
        {
          "name": "Add Member to Project",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Auto-register member if memberId is missing",
                  "if (!pm.collectionVariables.get('memberId')) {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/auth/register',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: {",
                  "      mode: 'raw',",
                  "      raw: JSON.stringify({",
                  "        name: 'Jane Member',",
                  "        email: 'member_' + Date.now() + '@example.com',",
                  "        password: 'password123'",
                  "      })",
                  "    }",
                  "  }, function (err, res) {",
                  "    if (!err) {",
                  "      var data = res.json();",
                  "      if (data.data && data.data.user) {",
                  "        pm.collectionVariables.set('memberId', data.data.user._id);",
                  "      }",
                  "    }",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/members/{{memberId}}",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "{{projectId}}", "members", "{{memberId}}"]
            }
          }
        },
        {
          "name": "Get Project Members",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/members",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "{{projectId}}", "members"]
            }
          }
        },
        {
          "name": "Remove Member from Project",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/members/{{memberId}}",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "{{projectId}}", "members", "{{memberId}}"]
            }
          }
        }
      ]
